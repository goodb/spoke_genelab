spokegenelab:E-GEOD-16515 a biolink:Study ;
    spokegenelab:experimental_factors "disease"^^xsd:string ;
    spokegenelab:project_title "Transcription profiling of human pancreatic tumor and normal samples from the Mayo clinic"^^xsd:string ;
    spokegenelab:project_type "Gene Expression Atlas"^^xsd:string ;
    spokegenelab:pubmed_id "19732725"^^xsd:string ;
    spokegenelab:secondary_accessions "GSE16515"^^xsd:string ;
    spokegenelab:source "GEA"^^xsd:string ;
    spokegenelab:submitter_affiliation "Mayo Clinic"^^xsd:string ;
    spokegenelab:submitter_email "wang.liewei@mayo.edu"^^xsd:string ;
    spokegenelab:submitter_name "Liewei Wang"^^xsd:string ;
    biolink:description "We used microarrays to identify the expression differences of FKBP5 gene between the pancreatic tumor and normal samples. On average normal samples had more FKBP5 expression compared to tumor samples .Experiment Overall Design: This experiment consists of 36 tumor samples and 16 normal samples; a total of 52 samples. 16 samples consist of both tumor and normal expression data, whereas 20 samples consist of only tumor data."^^xsd:string ;
    biolink:has_output spokegenelab:E-GEOD-16515-g1_g2 ;
    biolink:id "E-GEOD-16515"^^xsd:string ;
    biolink:in_taxon "9606"^^xsd:string,
        "Homo sapiens"^^xsd:string ;
    biolink:name "E-GEOD-16515"^^xsd:string .

